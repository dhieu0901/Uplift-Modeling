# Raw and processed Criteo data are far too large for version control and are
# rebuilt by scripts/prepare_criteo.py and scripts/prepare_audit_sample.py.
/data/

# Generated evidence under /outputs/ IS tracked on purpose: the tables, reports,
# and figures are the only way a reader can check the numbers in README.md
# without a multi-hour rerun against a 300 MB source file.

# The saved policy is a fitted booster, too large for version control and
# rebuilt in about a minute by scripts/fit_campaign_policy.py. The measurement
# it serves lives in outputs/tables/, which is tracked.
/artifacts/
/outputs/target_list.csv

# Jupyter writes these beside every notebook that is opened.
.ipynb_checkpoints/

/.agents/
/.venv/
/venv/
/.pytest_cache/
/.pytest-tmp/
/.ruff_cache/
__pycache__/
*.py[cod]
